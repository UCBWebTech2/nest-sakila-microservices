                    <xsd:sequence>
                        <xsd:element name="data" type="tns:Inventory" minOccurs="0" maxOccurs="unbounded"/>
                        <xsd:element name="meta" type="tns:PaginationMeta"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="InventoryResponse" type="tns:Inventory"/>

            <xsd:element name="CreateInventoryRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="filmId" type="xsd:int"/>
                        <xsd:element name="storeId" type="xsd:int"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="UpdateInventoryRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="id" type="xsd:int"/>
                        <xsd:element name="filmId" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="storeId" type="xsd:int" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="ListInventoriesRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="page" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="limit" type="xsd:int" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="GetInventoryRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="id" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="DeleteInventoryRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="id" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>

        </xsd:schema>
    </types>

    <!-- ================= Messages ================= -->
    <message name="DeleteResponseMessage"><part name="parameters" element="tns:DeleteResponse"/></message>

    <message name="ListFilmsRequestMessage"><part name="parameters" element="tns:ListFilmsRequest"/></message>
    <message name="GetFilmRequestMessage"><part name="parameters" element="tns:GetFilmRequest"/></message>
    <message name="DeleteFilmRequestMessage"><part name="parameters" element="tns:DeleteFilmRequest"/></message>
    <message name="ListFilmsResponseMessage"><part name="parameters" element="tns:ListFilmsResponse"/></message>
    <message name="FilmResponseMessage"><part name="parameters" element="tns:FilmResponse"/></message>
    <message name="CreateFilmRequestMessage"><part name="parameters" element="tns:CreateFilmRequest"/></message>
    <message name="UpdateFilmRequestMessage"><part name="parameters" element="tns:UpdateFilmRequest"/></message>

    <message name="ListActorsRequestMessage"><part name="parameters" element="tns:ListActorsRequest"/></message>
    <message name="GetActorRequestMessage"><part name="parameters" element="tns:GetActorRequest"/></message>
    <message name="DeleteActorRequestMessage"><part name="parameters" element="tns:DeleteActorRequest"/></message>
    <message name="ListActorsResponseMessage"><part name="parameters" element="tns:ListActorsResponse"/></message>
    <message name="ActorResponseMessage"><part name="parameters" element="tns:ActorResponse"/></message>
    <message name="CreateActorRequestMessage"><part name="parameters" element="tns:CreateActorRequest"/></message>
    <message name="UpdateActorRequestMessage"><part name="parameters" element="tns:UpdateActorRequest"/></message>

    <message name="ListCategoriesRequestMessage"><part name="parameters" element="tns:ListCategoriesRequest"/></message>
    <message name="GetCategoryRequestMessage"><part name="parameters" element="tns:GetCategoryRequest"/></message>
    <message name="DeleteCategoryRequestMessage"><part name="parameters" element="tns:DeleteCategoryRequest"/></message>
    <message name="ListCategoriesResponseMessage"><part name="parameters" element="tns:ListCategoriesResponse"/></message>
    <message name="CategoryResponseMessage"><part name="parameters" element="tns:CategoryResponse"/></message>
    <message name="CreateCategoryRequestMessage"><part name="parameters" element="tns:CreateCategoryRequest"/></message>
    <message name="UpdateCategoryRequestMessage"><part name="parameters" element="tns:UpdateCategoryRequest"/></message>

    <message name="ListLanguagesRequestMessage"><part name="parameters" element="tns:ListLanguagesRequest"/></message>
    <message name="GetLanguageRequestMessage"><part name="parameters" element="tns:GetLanguageRequest"/></message>
    <message name="DeleteLanguageRequestMessage"><part name="parameters" element="tns:DeleteLanguageRequest"/></message>
    <message name="ListLanguagesResponseMessage"><part name="parameters" element="tns:ListLanguagesResponse"/></message>
    <message name="LanguageResponseMessage"><part name="parameters" element="tns:LanguageResponse"/></message>
    <message name="CreateLanguageRequestMessage"><part name="parameters" element="tns:CreateLanguageRequest"/></message>
    <message name="UpdateLanguageRequestMessage"><part name="parameters" element="tns:UpdateLanguageRequest"/></message>

    <message name="ListInventoriesRequestMessage"><part name="parameters" element="tns:ListInventoriesRequest"/></message>
