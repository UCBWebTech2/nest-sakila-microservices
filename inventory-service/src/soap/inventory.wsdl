<?xml version="1.0" encoding="UTF-8"?>
<definitions name="InventoryService"
    targetNamespace="http://inventory-service.sakila/wsdl"
    xmlns:tns="http://inventory-service.sakila/wsdl"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns="http://schemas.xmlsoap.org/wsdl/">

    <types>
        <xsd:schema targetNamespace="http://inventory-service.sakila/wsdl">

            <!-- ================= Shared ================= -->
            <xsd:complexType name="PaginationMeta">
                <xsd:sequence>
                    <xsd:element name="page" type="xsd:int"/>
                    <xsd:element name="limit" type="xsd:int"/>
                    <xsd:element name="total" type="xsd:int"/>
                    <xsd:element name="pages" type="xsd:int"/>
                </xsd:sequence>
            </xsd:complexType>

            <!--
                Every operation gets its own uniquely-named request element, even ones that are
                structurally identical (e.g. GetFilmRequest/DeleteFilmRequest are both just {id}).
                Document/literal "wrapped" SOAP dispatches on the top-level request element name —
                sharing one generic element (e.g. a single IdRequest for every Get/Delete op) makes
                dispatch ambiguous: the server can no longer tell which operation was actually
                called from the body alone. Confirmed empirically, not just from the spec — an
                earlier shared-element version of this WSDL ran the right handler but a wrong one
                got appended too, visible in the response wrapper tag.
            -->

            <!-- Shared is fine here — it's a response (output) element, dispatch doesn't depend
                 on it, only on each operation's distinct *Request input (see note above). -->
            <xsd:element name="DeleteResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="success" type="xsd:boolean"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <!-- ================= Film ================= -->
            <xsd:complexType name="Film">
                <xsd:sequence>
                    <xsd:element name="id" type="xsd:int"/>
                    <xsd:element name="title" type="xsd:string"/>
                    <xsd:element name="description" type="xsd:string" minOccurs="0" nillable="true"/>
                    <xsd:element name="releaseYear" type="xsd:int" minOccurs="0" nillable="true"/>
                    <xsd:element name="languageId" type="xsd:int"/>
                    <xsd:element name="originalLanguageId" type="xsd:int" minOccurs="0" nillable="true"/>
                    <xsd:element name="rentalDuration" type="xsd:int"/>
                    <xsd:element name="rentalRate" type="xsd:string"/>
                    <xsd:element name="length" type="xsd:int" minOccurs="0" nillable="true"/>
                    <xsd:element name="replacementCost" type="xsd:string"/>
                    <xsd:element name="rating" type="xsd:string" minOccurs="0" nillable="true"/>
                    <xsd:element name="lastUpdate" type="xsd:dateTime"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:element name="ListFilmsResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="data" type="tns:Film" minOccurs="0" maxOccurs="unbounded"/>
                        <xsd:element name="meta" type="tns:PaginationMeta"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="FilmResponse" type="tns:Film"/>

            <xsd:element name="CreateFilmRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="title" type="xsd:string"/>
                        <xsd:element name="description" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="releaseYear" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="languageId" type="xsd:int"/>
                        <xsd:element name="originalLanguageId" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="rentalDuration" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="rentalRate" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="length" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="replacementCost" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="rating" type="xsd:string" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="UpdateFilmRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="id" type="xsd:int"/>
                        <xsd:element name="title" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="description" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="releaseYear" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="languageId" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="originalLanguageId" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="rentalDuration" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="rentalRate" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="length" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="replacementCost" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="rating" type="xsd:string" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="ListFilmsRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="page" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="limit" type="xsd:int" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="GetFilmRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="id" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="DeleteFilmRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="id" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <!-- ================= Actor ================= -->
            <xsd:complexType name="Actor">
                <xsd:sequence>
                    <xsd:element name="id" type="xsd:int"/>
                    <xsd:element name="firstName" type="xsd:string"/>
                    <xsd:element name="lastName" type="xsd:string"/>
                    <xsd:element name="lastUpdate" type="xsd:dateTime"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:element name="ListActorsResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="data" type="tns:Actor" minOccurs="0" maxOccurs="unbounded"/>
                        <xsd:element name="meta" type="tns:PaginationMeta"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="ActorResponse" type="tns:Actor"/>

            <xsd:element name="CreateActorRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="firstName" type="xsd:string"/>
                        <xsd:element name="lastName" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="UpdateActorRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="id" type="xsd:int"/>
                        <xsd:element name="firstName" type="xsd:string" minOccurs="0"/>
                        <xsd:element name="lastName" type="xsd:string" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="ListActorsRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="page" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="limit" type="xsd:int" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="GetActorRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="id" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="DeleteActorRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="id" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <!-- ================= Category ================= -->
            <xsd:complexType name="Category">
                <xsd:sequence>
                    <xsd:element name="id" type="xsd:int"/>
                    <xsd:element name="name" type="xsd:string"/>
                    <xsd:element name="lastUpdate" type="xsd:dateTime"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:element name="ListCategoriesResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="data" type="tns:Category" minOccurs="0" maxOccurs="unbounded"/>
                        <xsd:element name="meta" type="tns:PaginationMeta"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="CategoryResponse" type="tns:Category"/>

            <xsd:element name="CreateCategoryRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="name" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="UpdateCategoryRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="id" type="xsd:int"/>
                        <xsd:element name="name" type="xsd:string" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="ListCategoriesRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="page" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="limit" type="xsd:int" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="GetCategoryRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="id" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="DeleteCategoryRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="id" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <!-- ================= Language ================= -->
            <xsd:complexType name="Language">
                <xsd:sequence>
                    <xsd:element name="id" type="xsd:int"/>
                    <xsd:element name="name" type="xsd:string"/>
                    <xsd:element name="lastUpdate" type="xsd:dateTime"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:element name="ListLanguagesResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="data" type="tns:Language" minOccurs="0" maxOccurs="unbounded"/>
                        <xsd:element name="meta" type="tns:PaginationMeta"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="LanguageResponse" type="tns:Language"/>

            <xsd:element name="CreateLanguageRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="name" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="UpdateLanguageRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="id" type="xsd:int"/>
                        <xsd:element name="name" type="xsd:string" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <xsd:element name="ListLanguagesRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="page" type="xsd:int" minOccurs="0"/>
                        <xsd:element name="limit" type="xsd:int" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="GetLanguageRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="id" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="DeleteLanguageRequest">
                <xsd:complexType>
                    <xsd:sequence><xsd:element name="id" type="xsd:int"/></xsd:sequence>
                </xsd:complexType>
            </xsd:element>

            <!-- ================= Inventory ================= -->
            <xsd:complexType name="Inventory">
                <xsd:sequence>
                    <xsd:element name="id" type="xsd:int"/>
                    <xsd:element name="filmId" type="xsd:int"/>
                    <xsd:element name="storeId" type="xsd:int"/>
