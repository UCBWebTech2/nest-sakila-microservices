    </portType>

    <!-- ================= Binding ================= -->
    <binding name="InventoryBinding" type="tns:InventoryPortType">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>

        <operation name="ListFilms"><soap:operation soapAction="http://inventory-service.sakila/wsdl/ListFilms"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
