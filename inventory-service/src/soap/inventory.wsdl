            <output message="tns:FilmResponseMessage"/>
        </operation>
        <operation name="DeleteFilm">
            <input message="tns:DeleteFilmRequestMessage"/>
            <output message="tns:DeleteResponseMessage"/>
        </operation>

        <operation name="ListActors">
            <input message="tns:ListActorsRequestMessage"/>
            <output message="tns:ListActorsResponseMessage"/>
        </operation>
        <operation name="GetActor">
