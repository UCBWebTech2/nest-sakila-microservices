# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api

# CORS — '*', a single origin, or a comma-separated list of origins
CORS_ORIGINS=*

# Auth (JWT) — no DB here, this gateway holds no user data of its own. Credentials are verified
# by business-service's staffLogin mutation; this only signs the access token.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_TIME_EXPIRE=15m

# WebSockets
WEBSOCKET_NAMESPACE=app

# Microservices this gateway talks to
BUSINESS_SERVICE_GRAPHQL_URL=http://localhost:3001/graphql
INVENTORY_SERVICE_WSDL_URL=http://localhost:3003/soap?wsdl
REPORTING_SERVICE_WS_URL=http://localhost:3004
CUSTOMER_SERVICE_GRPC_URL=localhost:50051
CUSTOMER_SERVICE_RABBITMQ_URL=amqp://guest:guest@localhost:5672
CUSTOMER_SERVICE_RABBITMQ_QUEUE=customer_queue
BUSINESS_SERVICE_HEALTH_URL=http://localhost:3001/api/health
CUSTOMER_SERVICE_HEALTH_URL=http://localhost:3002/api/health
INVENTORY_SERVICE_HEALTH_URL=http://localhost:3003/api/health
REPORTING_SERVICE_HEALTH_URL=http://localhost:3004/api/health
