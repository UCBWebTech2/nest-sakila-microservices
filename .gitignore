# Dependencias y compilado
node_modules/
dist/
coverage/
*.tsbuildinfo

# Variables de entorno: cada servicio trae un .env.example; el .env real se copia de ahí
# y no se sube (puede tener credenciales o el JWT_SECRET).
.env
.env.*
!.env.example

# Se regenera al arrancar business-service (GraphQL code-first)
business-service/src/schema.gql

# Logs
*.log
npm-debug.log*

# Editor y sistema operativo (misma regla oficial de NestJS para VSCode: se versiona solo la
# configuración compartida del proyecto)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.DS_Store
