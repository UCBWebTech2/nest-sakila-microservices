# OPCIONAL. docker-compose.yml no necesita ningún .env: trae todo escrito y estos valores por defecto.
# Si quieres cambiar alguno, copia este archivo a `.env` (junto al compose) y descomenta la línea:
#
#   cp .env.example .env            (Windows PowerShell: Copy-Item .env.example .env)

# Contraseña del usuario `postgres` de la base que levanta el compose (por defecto: postgres).
# PostgreSQL la lee solo al crear el volumen; si la cambias después, usa `docker compose down -v`.
# DB_PASSWORD=postgres

# Clave con la que el gateway firma los tokens JWT (el compose trae una de desarrollo).
# JWT_SECRET=una_cadena_larga_y_secreta
