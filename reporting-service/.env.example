# api-gateway uses 3000, business-service 3001, inventory-service 3003 — every microservice
# needs its own port
NODE_ENV=development
PORT=3004
API_PREFIX=api

# CORS — '*', a single origin, or a comma-separated list of origins
CORS_ORIGINS=*

# Database (PostgreSQL) — the single Postgres shared by every microservice in this ecosystem,
# (see ../README.md). With the Postgres from ../docker-compose.yml it is published on host port 5433;
# a local Postgres is usually on 5432 — set DB_PORT/DB_PASSWORD to match whichever you use.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=sakila
DB_LOGS=false

# WebSockets (Socket.io) — the namespace the reports gateway listens on
WEBSOCKET_NAMESPACE=reports
